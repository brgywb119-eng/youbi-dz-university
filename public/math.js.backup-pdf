function cleanText(text) {
  return (text || "")
    .replace(/\s+/g, " ")
    .replace(/[📖📝🧩▶️📐🎓]/g, "")
    .trim();
}

function getMathSubject(card) {
  const text = cleanText(card.textContent);

  for (const name of Object.keys(mathData)) {
    if (text === name || text.includes(name)) {
      return name;
    }
  }

  return null;
}

function resourceHTML(items) {
  if (!items || items.length === 0) {
    return '<div class="empty-learning">لا يوجد محتوى حاليا.</div>';
  }

  return items.map(item => `
    <a class="learning-card"
       href="${item[1]}"
       target="_blank"
       rel="noopener noreferrer"
       style="display:flex!important;justify-content:space-between;align-items:center;text-decoration:none;cursor:pointer;">
      <span>${item[0]}</span>
      <strong>فتح ↗</strong>
    </a>
  `).join("");
}

function showMathSubject(subject) {
  const data = mathData[subject];
  if (!data) return;

  const old = document.querySelector(".math-resource-overlay");
  if (old) old.remove();

  const overlay = document.createElement("div");
  overlay.className = "math-resource-overlay";

  overlay.style.cssText = `
    position:fixed;
    inset:0;
    z-index:999999;
    background:rgba(0,0,0,.82);
    display:flex;
    align-items:center;
    justify-content:center;
    padding:15px;
  `;

  overlay.innerHTML = `
    <div style="
      width:min(850px,100%);
      max-height:90vh;
      overflow:auto;
      background:#101522;
      color:#fff;
      border-radius:22px;
      padding:20px;
      border:1px solid rgba(255,255,255,.15);
      box-shadow:0 20px 80px rgba(0,0,0,.6);
      direction:rtl;
    ">
      <button id="mathClose" style="
        float:left;
        border:0;
        background:#222b3d;
        color:white;
        width:40px;
        height:40px;
        border-radius:50%;
        font-size:25px;
        cursor:pointer;
      ">×</button>

      <div style="padding:10px 5px 20px;text-align:right;">
        <div style="font-size:14px;opacity:.7;">رياضيات — السنة الأولى</div>
        <h2 style="margin:5px 0;">📐 ${subject}</h2>
      </div>

      <div id="mathTabs" style="
        display:grid;
        grid-template-columns:repeat(4,1fr);
        gap:7px;
        margin-bottom:15px;
      ">
        <button data-tab="lessons">📖 الدروس</button>
        <button data-tab="summaries">📝 الملخصات</button>
        <button data-tab="exercises">🧩 التمارين</button>
        <button data-tab="videos">▶️ الفيديوهات</button>
      </div>

      <div id="mathContent"></div>
    </div>
  `;

  document.body.appendChild(overlay);

  overlay.querySelectorAll("#mathTabs button").forEach(btn => {
    btn.style.cssText = `
      border:1px solid rgba(255,255,255,.15);
      background:#182235;
      color:white;
      padding:12px 5px;
      border-radius:12px;
      cursor:pointer;
      font-size:14px;
    `;

    btn.onclick = () => {
      overlay.querySelectorAll("#mathTabs button").forEach(b => {
        b.style.background = "#182235";
      });

      btn.style.background = "#284d72";

      document.getElementById("mathContent").innerHTML =
        resourceHTML(data[btn.dataset.tab]);
    };
  });

  overlay.querySelector("#mathClose").onclick = () => overlay.remove();

  overlay.addEventListener("click", e => {
    if (e.target === overlay) overlay.remove();
  });

  // افتح الدروس مباشرة
  overlay.querySelector('[data-tab="lessons"]').click();
}

document.addEventListener("click", function(e) {
  const card = e.target.closest(".subject-card");
  if (!card) return;

  const panel = card.closest(".subjects-panel");
  if (!panel) return;

  const panelText = cleanText(panel.textContent);

  if (!panelText.includes("رياضيات")) return;

  const subject = getMathSubject(card);

  if (!subject) return;

  e.preventDefault();
  e.stopPropagation();
  e.stopImmediatePropagation();

  showMathSubject(subject);
}, true);

console.log("✅ Math resources loaded:", Object.keys(mathData).length);
