  function esc(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  function openMathSubject(subject) {
    const data = mathData[subject];
    if (!data) return;

    const old = document.querySelector(".math-2024-overlay");
    if (old) old.remove();

    const overlay = document.createElement("div");
    overlay.className = "math-2024-overlay";

    overlay.innerHTML = `
      <div class="math-2024-box">
        <button class="math-2024-close">×</button>

        <div class="math-2024-head">
          <div class="math-2024-icon">📐</div>
          <div>
            <h2>${esc(subject)}</h2>
            <p>رياضيات — السنة الأولى — 2023/2024</p>
          </div>
        </div>

        <div class="math-2024-tabs">
          <button data-tab="lessons">📖 الدروس PDF</button>
          <button data-tab="summaries">📝 الملخصات PDF</button>
          <button data-tab="exercises">🧩 التمارين PDF</button>
          <button data-tab="videos">▶️ الفيديوهات</button>
        </div>

        <div class="math-2024-content"></div>
      </div>
    `;

    document.body.appendChild(overlay);

    const content = overlay.querySelector(".math-2024-content");
    const tabs = overlay.querySelectorAll("[data-tab]");

    function render(tab) {
      tabs.forEach(function (b) {
        b.classList.toggle("active", b.dataset.tab === tab);
      });

      const list = data[tab] || [];

      if (!list.length) {
        content.innerHTML = `
          <div class="math-empty">
            لا توجد ملفات مضافة حاليا.
          </div>
        `;
        return;
      }

      content.innerHTML = list.map(function (item) {
        return `
          <a class="math-resource"
             href="${esc(item[1])}"
             target="_blank"
             rel="noopener noreferrer">
            <span class="math-resource-icon">
              ${tab === "videos" ? "▶️" : "📄"}
            </span>
            <span>
              <strong>${esc(item[0])}</strong>
              <small>
                ${tab === "videos" ? "فتح الفيديوهات" : "فتح ملف PDF / وثائق 2023-2024"}
              </small>
            </span>
            <span class="math-open">فتح ↗</span>
          </a>
        `;
      }).join("");
    }

    tabs.forEach(function (b) {
      b.addEventListener("click", function () {
        render(b.dataset.tab);
      });
    });

    overlay.querySelector(".math-2024-close").onclick = function () {
      overlay.remove();
    };

    overlay.addEventListener("click", function (e) {
      if (e.target === overlay) overlay.remove();
    });

    render("lessons");
  }

  document.addEventListener("click", function (e) {
    const card = e.target.closest(".subject-card");
    if (!card) return;

    const panel = card.closest(".subjects-panel");
    if (!panel) return;

    if (!(panel.innerText || "").includes("رياضيات")) return;

    const name =
      card.querySelector("h4, h3, strong, .subject-name")?.textContent.trim()
      || card.textContent.trim().split("\n")[0].trim();

    if (!mathData[name]) return;

    e.preventDefault();
    e.stopPropagation();
    e.stopImmediatePropagation();

    openMathSubject(name);
  }, true);

