<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Youbi DZ University</title>

<style>
:root{
  --bg:#071522;
  --card:rgba(255,255,255,.08);
  --text:#fff;
  --muted:#b8c5d2;
  --green:#28d982;
  --border:rgba(255,255,255,.14);
}

body.light{
  --bg:#f2f6f8;
  --card:rgba(255,255,255,.9);
  --text:#12202d;
  --muted:#657482;
  --green:#079957;
  --border:rgba(0,0,0,.1);
}

*{
  box-sizing:border-box;
  margin:0;
  padding:0;
  font-family:Arial,Tahoma,sans-serif;
}

html{
  scroll-behavior:smooth;
}

body{
  min-height:100vh;
  color:var(--text);
  background:
    linear-gradient(rgba(3,15,28,.76),rgba(2,10,22,.96)),
    url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=2000&q=90")
    center/cover fixed;
  transition:.3s;
}

body.light{
  background:
    linear-gradient(rgba(245,248,250,.9),rgba(245,248,250,.97)),
    url("https://images.unsplash.com/photo-1523050854058-8df90110c9f1?auto=format&fit=crop&w=2000&q=90")
    center/cover fixed;
}

/* NAV */

nav{
  position:sticky;
  top:0;
  z-index:20;
  height:70px;
  padding:0 6%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:rgba(3,15,28,.82);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--border);
}

body.light nav{
  background:rgba(255,255,255,.85);
}

.logo{
  font-size:21px;
  font-weight:bold;
}

.logo span{
  color:var(--green);
}

.theme{
  width:42px;
  height:42px;
  border-radius:50%;
  border:1px solid var(--border);
  background:var(--card);
  color:var(--text);
  font-size:20px;
  cursor:pointer;
}

/* HERO */

.hero{
  min-height:570px;
  display:flex;
  align-items:center;
  justify-content:center;
  text-align:center;
  padding:70px 20px;
}

.hero-content{
  max-width:850px;
}

.badge{
  display:inline-block;
  padding:9px 18px;
  border:1px solid var(--green);
  border-radius:30px;
  color:var(--green);
  margin-bottom:25px;
}

h1{
  font-size:clamp(44px,10vw,82px);
  line-height:1;
  margin-bottom:24px;
}

h1 span{
  color:var(--green);
}

.subtitle{
  color:var(--muted);
  font-size:19px;
  line-height:1.9;
}

.buttons{
  margin-top:32px;
  display:flex;
  justify-content:center;
  gap:12px;
}

.buttons a{
  text-decoration:none;
  padding:14px 27px;
  border-radius:30px;
  font-weight:bold;
}

.primary{
  background:var(--green);
  color:#052117;
}

.secondary{
  color:var(--text);
  background:var(--card);
  border:1px solid var(--border);
}

/* COMMON */

section{
  padding:65px 6%;
}

.title{
  text-align:center;
  margin-bottom:35px;
}

.title h2{
  font-size:30px;
  margin-bottom:10px;
}

.title p{
  color:var(--muted);
}

/* FIELDS */

.fields{
  background:rgba(0,0,0,.15);
}

.field-list{
  max-width:1000px;
  margin:auto;
  display:flex;
  flex-direction:column;
  gap:18px;
}

.field{
  background:var(--card);
  border:1px solid var(--border);
  border-radius:22px;
  padding:22px;
}

.field-header{
  display:flex;
  align-items:center;
  gap:15px;
  margin-bottom:20px;
}

.field-icon{
  width:55px;
  height:55px;
  border-radius:16px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(40,217,130,.12);
  font-size:29px;
}

.field-header h3{
  font-size:21px;
}

.field-header small{
  color:var(--green);
  display:block;
  margin-top:5px;
}

.specialties{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:10px;
}

.specialty{
  padding:15px;
  border-radius:13px;
  background:rgba(255,255,255,.05);
  border:1px solid var(--border);
}

/* SCHEDULE */

.schedule{
  background:rgba(0,0,0,.12);
}

.table-container{
  max-width:1100px;
  margin:auto;
  overflow-x:auto;
  border-radius:18px;
  border:1px solid var(--border);
}

table{
  width:100%;
  min-width:850px;
  border-collapse:collapse;
  background:var(--card);
}

th,td{
  border:1px solid var(--border);
  padding:14px;
  text-align:center;
  height:55px;
}

th{
  background:var(--green);
  color:#052117;
}

.time{
  color:var(--green);
  font-weight:bold;
}

/* FOOTER */

footer{
  text-align:center;
  padding:25px;
  background:var(--bg);
  color:var(--muted);
}

/* MOBILE */

@media(max-width:600px){

  nav{
    padding:0 5%;
  }

  .logo{
    font-size:17px;
  }

  .buttons{
    flex-direction:column;
  }

  .specialties{
    grid-template-columns:1fr;
  }

  section{
    padding:55px 5%;
  }
}
</style>
</head>

