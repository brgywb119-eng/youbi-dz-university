function getSpecialty(card){
const panel=card.closest(".subjects-panel");
if(!panel)return "";
const h=panel.querySelector("h3");
return h ? h.textContent.replace("🎓","").trim() : "";
}

function makeCards(items,empty){
if(!items || !items.length)
return `<div class="empty-learning">${empty}</div>`;

return items.map(function(item){
return `
<a class="learning-card" href="${item[1]}" target="_blank" rel="noopener">
<span>${item[0]}</span>
<span class="open-resource">فتح ↗</span>
</a>`;
}).join("");
}

function openLearning(card){

const subject=card.textContent.replace("📚","").trim();
const specialty=getSpecialty(card);

const info=(data[specialty] && data[specialty][subject]) || {
lessons:[],summaries:[],exercises:[],videos:[]
};

document.querySelector(".learning-overlay")?.remove();

const overlay=document.createElement("div");
overlay.className="learning-overlay";

overlay.innerHTML=`
<div class="learning-box">

<button class="learning-close">×</button>

<div class="learning-header">
<div class="learning-icon">⚖️</div>
<div>
<div class="learning-label">${specialty}</div>
<h2>${subject}</h2>
<small>السنة الأولى ليسانس حقوق</small>
</div>
</div>

<div class="learning-tabs">

<button class="learning-tab active" data-tab="lessons">
📖 الدروس
</button>

<button class="learning-tab" data-tab="summaries">
📝 الملخصات
</button>

<button class="learning-tab" data-tab="exercises">
🧩 التمارين
</button>

<button class="learning-tab" data-tab="videos">
▶️ فيديوهات
</button>

</div>

<div class="learning-content">

<section class="learning-section active" data-section="lessons">
${makeCards(info.lessons,"لا توجد دروس PDF مضافة حاليا")}
</section>

<section class="learning-section" data-section="summaries">
${makeCards(info.summaries,"لا توجد ملخصات مضافة حاليا")}
</section>

<section class="learning-section" data-section="exercises">
${makeCards(info.exercises,"لا توجد تمارين مضافة حاليا")}
</section>

<section class="learning-section" data-section="videos">
${makeCards(info.videos,"لا توجد فيديوهات مضافة حاليا")}
</section>

</div>
</div>
`;

document.body.appendChild(overlay);

overlay.querySelector(".learning-close").onclick=()=>{
overlay.remove();
};

overlay.addEventListener("click",function(e){
if(e.target===overlay) overlay.remove();
});

overlay.querySelectorAll(".learning-tab").forEach(function(tab){

tab.onclick=function(){

overlay.querySelectorAll(".learning-tab")
.forEach(x=>x.classList.remove("active"));

overlay.querySelectorAll(".learning-section")
.forEach(x=>x.classList.remove("active"));

tab.classList.add("active");

const section=overlay.querySelector(
'[data-section="'+tab.dataset.tab+'"]'
);

if(section) section.classList.add("active");

};

});

}

document.addEventListener("click",function(e){

const card=e.target.closest(".subject-card");

if(card){
e.preventDefault();
openLearning(card);
}

});

console.log("✅ حقوق: الدروس والملخصات والتمارين والفيديوهات جاهزة");

})();
