<script>
/* جعل خانات جدول الوقت قابلة للكتابة */
document.addEventListener("DOMContentLoaded", function(){

  const cells = document.querySelectorAll(".schedule tbody td:not(.time)");

  cells.forEach(function(cell){

    cell.classList.add("editable");
    cell.setAttribute("contenteditable","true");
    cell.setAttribute("spellcheck","false");

    cell.addEventListener("input", function(){
      const key = "youbi_schedule_" + this.parentElement.rowIndex + "_" + this.cellIndex;
      localStorage.setItem(key, this.innerText);
    });

    const key = "youbi_schedule_" + cell.parentElement.rowIndex + "_" + cell.cellIndex;
    const saved = localStorage.getItem(key);

    if(saved){
      cell.innerText = saved;
    }
  });

});
</script>


