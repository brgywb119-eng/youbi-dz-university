<style>

/* =====================================
   Youbi DZ University - Neon Fields
   ===================================== */

.neon-fields{
  width:100%;
  max-width:1100px;
  margin:35px auto;
  padding:30px 20px 45px;
  box-sizing:border-box;
}

.neon-fields-title{
  text-align:center;
  margin-bottom:30px;
}

.neon-fields-title .graduation-icon{
  font-size:38px;
  margin-bottom:8px;
}

.neon-fields-title span{
  color:#35e5bd;
  font-size:14px;
  font-weight:800;
}

.neon-fields-title h2{
  margin:7px 0;
  color:#ffffff;
  font-size:30px;
  font-weight:900;
}

.neon-fields-title p{
  margin:0;
  color:#9fb1c9;
  font-size:14px;
}


/* شبكة البطاقات */

.neon-fields-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:22px;
}


/* البطاقة */

.neon-field{
  position:relative;
  padding:24px;
  border-radius:22px;
  background:rgba(4,25,50,.88);
  overflow:hidden;
  backdrop-filter:blur(12px);
  box-shadow:0 15px 40px rgba(0,0,0,.30);
  transition:.3s ease;
}

.neon-field:hover{
  transform:translateY(-4px);
}


/* ألوان المجالات */

.law-field{
  border:1px solid #ef3768;
  box-shadow:
    0 0 25px rgba(239,55,104,.12),
    inset 0 0 25px rgba(239,55,104,.05);
}

.math-field{
  border:1px solid #00aaff;
  box-shadow:
    0 0 25px rgba(0,170,255,.12),
    inset 0 0 25px rgba(0,170,255,.05);
}

.biology-field{
  border:1px solid #28e98a;
  box-shadow:
    0 0 25px rgba(40,233,138,.12),
    inset 0 0 25px rgba(40,233,138,.05);
}

.technology-field{
  border:1px solid #00aaff;
  box-shadow:
    0 0 25px rgba(0,170,255,.12),
    inset 0 0 25px rgba(0,170,255,.05);
}


/* رأس البطاقة */

.neon-field-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  direction:rtl;
  margin-bottom:18px;
}



.neon-field-head h3{
  margin:8px 0 0;
  color:#fff;
  font-size:23px;
  font-weight:900;
}

.neon-field-icon{
  width:68px;
  height:68px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:32px;
  flex-shrink:0;
  background:rgba(255,255,255,.08);
}

.law-field .neon-field-icon{
  border:1px solid #ef3768;
  box-shadow:0 0 25px rgba(239,55,104,.35);
}

.math-field .neon-field-icon,
.technology-field .neon-field-icon{
  border:1px solid #00aaff;
  box-shadow:0 0 25px rgba(0,170,255,.35);
}

.biology-field .neon-field-icon{
  border:1px solid #28e98a;
  box-shadow:0 0 25px rgba(40,233,138,.35);
}


/* قائمة التخصصات */

.neon-specialties{
  border:1px solid rgba(255,255,255,.14);
  border-radius:18px;
  padding:8px;
  background:rgba(0,0,0,.13);
}

.neon-specialty{
  width:100%;
  border:0;
  border-bottom:1px solid rgba(255,255,255,.08);
  background:transparent;
  color:#dce8f7;
  display:flex;
  align-items:center;
  gap:12px;
  padding:11px 9px;
  font-family:inherit;
  text-align:right;
  cursor:pointer;
}

.neon-specialty:last-child{
  border-bottom:0;
}

.neon-specialty span{
  width:31px;
  height:31px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  background:rgba(255,255,255,.10);
  font-size:15px;
}

.neon-specialty b{
  flex:1;
  font-size:15px;
  font-weight:700;
}

.neon-specialty small{
  opacity:.65;
  font-size:11px;
}

.neon-specialty:hover{
  background:rgba(255,255,255,.06);
}


/* زر جميع التخصصات */

.show-specialties{
  width:100%;
  margin-top:17px;
  padding:7px 0;
  border:0;
  background:transparent;
  color:#39e5c1;
  font-family:inherit;
  font-size:15px;
  font-weight:900;
  cursor:pointer;
  text-align:right;
}

.law-field .show-specialties{
  color:#ff4c7b;
}

.show-specialties strong{
  font-size:25px;
  vertical-align:-2px;
  margin-right:7px;
}


/* الهاتف */

@media(max-width:700px){

  .neon-fields{
    padding:25px 12px 35px;
  }

  .neon-fields-grid{
    grid-template-columns:1fr;
    gap:17px;
  }

  .neon-fields-title h2{
    font-size:25px;
  }

  .neon-field{
    padding:18px;
    border-radius:19px;
  }

  .neon-field-head h3{
    font-size:20px;
  }

  .neon-field-icon{
    width:58px;
    height:58px;
    font-size:27px;
  }

}

</style>


