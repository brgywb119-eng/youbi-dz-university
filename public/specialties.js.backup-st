      "اللغة الأجنبية",
      "الخوارزميات"
    ],

    "رياضيات": [
      "التحليل",
      "الجبر",
      "الهندسة",
      "الإحصاء",
      "الفيزياء",
      "الخوارزميات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "رياضيات تطبيقية": [
      "التحليل",
      "الجبر",
      "الإحصاء والاحتمالات",
      "البرمجة",
      "الفيزياء",
      "الخوارزميات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "إعلام آلي": [
      "الخوارزميات وهياكل البيانات",
      "البرمجة",
      "التحليل",
      "الجبر",
      "المنطق الرياضي",
      "نظم المعلومات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "بيولوجيا": [
      "بيولوجيا الخلية",
      "الكيمياء العامة",
      "الرياضيات والإحصاء",
      "الفيزياء",
      "علم الحيوان",
      "علم النبات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "علوم زراعية": [
      "علم النبات",
      "علم الحيوان",
      "الكيمياء العامة",
      "الفيزياء",
      "الرياضيات والإحصاء",
      "علوم التربة",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "بيئة وتنوع بيولوجي": [
      "علم البيئة",
      "بيولوجيا الخلية",
      "علم الحيوان",
      "علم النبات",
      "الكيمياء العامة",
      "الرياضيات والإحصاء",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "هندسة مدنية": [
      "الرياضيات",
      "الفيزياء",
      "الكيمياء",
      "الرسم التقني",
      "ميكانيك النقطة",
      "الخوارزميات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "هندسة ميكانيكية": [
      "الرياضيات",
      "الفيزياء",
      "الكيمياء",
      "الرسم التقني",
      "ميكانيك",
      "الخوارزميات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "هندسة كهربائية": [
      "الرياضيات",
      "الفيزياء",
      "الكهرباء",
      "الإلكترونيات",
      "الرسم التقني",
      "الخوارزميات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ],

    "تكنولوجيا المعلومات": [
      "الرياضيات",
      "الخوارزميات",
      "البرمجة",
      "الفيزياء",
      "الشبكات",
      "نظم المعلومات",
      "اللغة الأجنبية",
      "منهجية العمل الجامعي"
    ]
  };

  document.querySelectorAll(".neon-specialty").forEach(function (btn) {

    btn.addEventListener("click", function () {

      const nameElement = btn.querySelector("b");
      if (!nameElement) return;

      const name = nameElement.textContent.trim();
      const field = btn.closest(".neon-field");
      if (!field) return;

      let panel = field.querySelector(".subjects-panel");

      if (!panel) {
        panel = document.createElement("div");
        panel.className = "subjects-panel";
        field.appendChild(panel);
      }

      const subjects = subjectsData[name] || [];

      panel.innerHTML = `
        <h3>🎓 ${name}</h3>
        <div class="subjects-year">السنة الأولى</div>
        <div class="subjects-grid">
          ${subjects.map(function(subject) {
            return `<div class="subject-card">📚 ${subject}</div>`;
          }).join("")}
        </div>
      `;

      panel.classList.add("active");
      panel.scrollIntoView({
        behavior: "smooth",
        block: "center"
      });

    });

  });

});
console.log('✅ specialties.js loaded');
