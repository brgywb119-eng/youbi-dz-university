function openMath(card){

const panel=card.closest(".subjects-panel");
if(!panel)return;

const title=panel.querySelector("h3");
if(!title)return;

const specialty=title.textContent.replace("🎓","").trim();

if(specialty!=="رياضيات")return;

const subject=card.textContent.replace("📚","").trim();
const info=mathData["رياضيات"][subject];

if(!info)return;

document.querySelector(".learning-overlay")?.remove();

const overlay=document.createElement("div");
overlay.className="learning-overlay";

function cards(items){
return items.map(function(item){
return `
<a class="learning-card" href="${item[1]}" target="_blank" rel="noopener">
<span>${item[0]}</span>
<span class="open-resource">فتح ↗</span>
</a>`;
}).join("");
}

overlay.innerHTML=`
<div class="learning-box">

<button class="learning-close">×</button>

<div class="learning-header">

<div class="learning-icon">∑</div>

<div>
<div class="learning-label">رياضيات</div>
<h2>${subject}</h2>
<small>السنة الأولى ليسانس</small>
</div>

</div>

<div class="learning-tabs">

<button class="learning-tab active" data-tab="lessons">📖 الدروس</button>
<button class="learning-tab" data-tab="summaries">📝 الملخصات</button>
<button class="learning-tab" data-tab="exercises">🧩 التمارين</button>
<button class="learning-tab" data-tab="videos">▶️ فيديوهات</button>

</div>

<div class="learning-content">

<section class="learning-section active" data-section="lessons">
${cards(info.lessons)}
</section>

<section class="learning-section" data-section="summaries">
${cards(info.summaries)}
</section>

<section class="learning-section" data-section="exercises">
${cards(info.exercises)}
</section>

<section class="learning-section" data-section="videos">
${cards(info.videos)}
</section>

</div>

</div>
`;

document.body.appendChild(overlay);

overlay.querySelector(".learning-close").onclick=()=>{
overlay.remove();
};

overlay.addEventListener("click",function(e){
if(e.target===overlay)overlay.remove();
});

overlay.querySelectorAll(".learning-tab").forEach(function(tab){

tab.onclick=function(){

overlay.querySelectorAll(".learning-tab")
.forEach(x=>x.classList.remove("active"));

overlay.querySelectorAll(".learning-section")
.forEach(x=>x.classList.remove("active"));

tab.classList.add("active");

const section=overlay.querySelector(
'[data-section="'+tab.dataset.tab+'"]'
);

if(section)section.classList.add("active");

};

});

}

document.addEventListener("click",function(e){

const card=e.target.closest(".subject-card");

if(card)openMath(card);

});

console.log("✅ نظام رياضيات جاهز");

})();

